#!/usr/bin/env bash
# Bootstrap a TrueNAS workload for AWS IAM Roles Anywhere.
#
# Usage:
#   truenas-roles-anywhere-bootstrap AWS_RA_BACKUP -- my-service
#
# The script generates the private key locally, stores it on a persistent
# volume, obtains a certificate from the trust appliance, writes an AWS config
# file, and then execs the requested command with AWS_PROFILE set.
#
# There is no enrollment secret and no approval step. The trust appliance
# issues to workload ids declared in its own site policy and refuses anything
# else, so a container whose id is declared starts unattended; afterwards it
# renews by presenting the certificate it already holds.
set -euo pipefail

ENV_PREFIX="${1:-AWS_RA}"
if [ $# -gt 0 ]; then
  shift
fi
if [ "${1:-}" = "--" ]; then
  shift
fi

if [[ ! "${ENV_PREFIX}" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
  echo "Invalid env prefix ${ENV_PREFIX}" >&2
  exit 1
fi

get_env() {
  local name="${ENV_PREFIX}_$1"
  local value="${!name:-}"
  if [ -z "${value}" ]; then
    echo "Missing required env var ${name}" >&2
    exit 1
  fi
  printf '%s' "${value}"
}

WORKLOAD_ID="$(get_env WORKLOAD_ID)"
if [[ ! "${WORKLOAD_ID}" =~ ^spiffe://ahara/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid workload id ${WORKLOAD_ID}" >&2
  exit 1
fi
ENROLLMENT_URL="$(get_env ENROLLMENT_URL)"
TRUST_ANCHOR_ARN="$(get_env TRUST_ANCHOR_ARN)"
PROFILE_ARN="$(get_env PROFILE_ARN)"
ENTRY_ROLE_ARN="$(get_env ENTRY_ROLE_ARN)"
ROLE_ARN="$(get_env ROLE_ARN)"

SAFE_NAME="$(printf '%s' "${WORKLOAD_ID}" | sed 's#[^A-Za-z0-9_.-]#_#g')"
SESSION_NAME="truenas-$(printf '%s' "${WORKLOAD_ID}" | sha256sum | awk '{print substr($1, 1, 16)}')"
CERT_DIR_VAR="${ENV_PREFIX}_CERT_DIR"
CERT_DIR="${!CERT_DIR_VAR:-/var/lib/ahara/aws-identity/${SAFE_NAME}}"
PROFILE_NAME_VAR="${ENV_PREFIX}_AWS_PROFILE"
PROFILE_NAME="${!PROFILE_NAME_VAR:-truenas-workload}"

KEY_FILE="${CERT_DIR}/private-key.pem"
CSR_FILE="${CERT_DIR}/request.csr"
CERT_FILE="${CERT_DIR}/certificate.pem"
CHAIN_FILE="${CERT_DIR}/certificate-chain.pem"
AWS_CONFIG_FILE_PATH="${CERT_DIR}/aws-config"

mkdir -p "${CERT_DIR}"
chmod 700 "${CERT_DIR}"

if [ ! -f "${KEY_FILE}" ]; then
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "${KEY_FILE}"
  chmod 600 "${KEY_FILE}"
fi

same_key_pair() {
  local certificate_public private_public
  certificate_public="$(openssl x509 -in "$1" -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | openssl sha256)" || return 1
  private_public="$(openssl pkey -in "$2" -pubout -outform DER 2>/dev/null \
    | openssl sha256)" || return 1
  [ "${certificate_public}" = "${private_public}" ]
}

certificate_has_workload() {
  local san uri_sans
  san="$(openssl x509 -in "$1" -noout -ext subjectAltName 2>/dev/null)" || return 1
  uri_sans="$(printf '%s\n' "${san}" | tr ',' '\n' \
    | sed -n 's/^[[:space:]]*URI://p')"
  [ "${uri_sans}" = "${WORKLOAD_ID}" ]
}

# The CA is trust-on-first-use. Once stored, a corrupt or replaced pin needs an
# explicit volume reset; silently fetching a new one would discard that trust
# decision on an ordinary restart.
if [ -e "${CHAIN_FILE}" ] \
  && ! openssl x509 -in "${CHAIN_FILE}" -noout -subject >/dev/null 2>&1; then
  echo "Pinned trust-appliance authority is unusable at ${CHAIN_FILE}" >&2
  echo "Restore it, or remove the identity volume to enroll from a new authority." >&2
  exit 1
fi

certificate_valid=false
if [ -f "${CERT_FILE}" ] \
  && openssl x509 -checkend 0 -noout -in "${CERT_FILE}" >/dev/null 2>&1 \
  && [ -f "${CHAIN_FILE}" ] \
  && openssl verify -CAfile "${CHAIN_FILE}" "${CERT_FILE}" >/dev/null 2>&1 \
  && same_key_pair "${CERT_FILE}" "${KEY_FILE}" \
  && certificate_has_workload "${CERT_FILE}"; then
  certificate_valid=true
elif [ -e "${CERT_FILE}" ]; then
  echo "Stored identity is expired, corrupt, mismatched, or names another workload; enrolling afresh" >&2
  rm -f "${CERT_FILE}"
fi

needs_enrollment=false
if [ "${certificate_valid}" != "true" ] \
  || ! openssl x509 -checkend 604800 -noout -in "${CERT_FILE}" >/dev/null 2>&1; then
  needs_enrollment=true
fi

if [ "${needs_enrollment}" = "true" ]; then
  CSR_CONFIG="$(mktemp)"
  PAYLOAD_FILE="$(mktemp)"
  RESPONSE_FILE="$(mktemp)"
  trap 'rm -f "${CSR_CONFIG}" "${PAYLOAD_FILE}" "${RESPONSE_FILE}"' EXIT

  cat > "${CSR_CONFIG}" <<EOF
[req]
prompt = no
distinguished_name = dn
req_extensions = v3_req

[dn]
CN = truenas-workload

[v3_req]
subjectAltName = URI:${WORKLOAD_ID}
EOF

  openssl req -new -key "${KEY_FILE}" -out "${CSR_FILE}" -config "${CSR_CONFIG}"

  python3 - "${WORKLOAD_ID}" "${CSR_FILE}" > "${PAYLOAD_FILE}" <<'PY'
import json
import sys
from pathlib import Path

workload_id, csr_path = sys.argv[1:]
print(json.dumps({
    "workload_id": workload_id,
    "csr_pem": Path(csr_path).read_text(),
}))
PY

  # Renewal presents the certificate already held. A first enrollment has
  # nothing to present, so it is gated by the declaration instead.
  if [ "${certificate_valid}" = "true" ]; then
    ENDPOINT="${ENROLLMENT_URL}/renew"
    AUTH_ARGS=(--cert "${CERT_FILE}" --key "${KEY_FILE}")
  else
    ENDPOINT="${ENROLLMENT_URL}/enroll"
    AUTH_ARGS=()
  fi

  if [ -f "${CHAIN_FILE}" ]; then
    TLS_ARGS=(--cacert "${CHAIN_FILE}")
  else
    # First contact only. The returned CA becomes the persistent pin after the
    # issued identity verifies against it.
    TLS_ARGS=(-k)
  fi
  HTTP_CODE=000
  HTTP_CODE="$(curl -s "${TLS_ARGS[@]}" -o "${RESPONSE_FILE}" -w '%{http_code}' \
    -X POST \
    -H "content-type: application/json" \
    "${AUTH_ARGS[@]}" \
    --data-binary @"${PAYLOAD_FILE}" \
    "${ENDPOINT}")" || true

  case "${HTTP_CODE}" in
    200) ;;
    000)
      echo "Trust appliance unreachable at ${ENROLLMENT_URL}" >&2
      exit 1
      ;;
    403)
      echo "${WORKLOAD_ID} is not declared on the trust appliance." >&2
      echo "Add it to identity.allowedWorkloads in ahara-trust and deploy." >&2
      exit 1
      ;;
    *)
      echo "Enrollment refused (HTTP ${HTTP_CODE})" >&2
      exit 1
      ;;
  esac

  python3 - "${RESPONSE_FILE}" "${CERT_FILE}.new" "${CHAIN_FILE}.new" <<'PY'
import json
import sys
from pathlib import Path

response_path, cert_path, chain_path = sys.argv[1:]
data = json.loads(Path(response_path).read_text())
if "error" in data:
    raise SystemExit(data["error"])
Path(cert_path).write_text(data["certificate_pem"])
Path(chain_path).write_text(data["chain_pem"])
PY

  VERIFY_CHAIN="${CHAIN_FILE}.new"
  if [ -f "${CHAIN_FILE}" ]; then
    if ! cmp -s "${CHAIN_FILE}.new" "${CHAIN_FILE}"; then
      echo "Trust appliance returned a different authority than the pinned one; discarding" >&2
      rm -f "${CERT_FILE}.new" "${CHAIN_FILE}.new"
      exit 1
    fi
    VERIFY_CHAIN="${CHAIN_FILE}"
  fi

  if ! openssl verify -CAfile "${VERIFY_CHAIN}" "${CERT_FILE}.new" >/dev/null 2>&1; then
    echo "Issued certificate does not chain to the authority; discarding" >&2
    rm -f "${CERT_FILE}.new" "${CHAIN_FILE}.new"
    exit 1
  fi
  if ! same_key_pair "${CERT_FILE}.new" "${KEY_FILE}"; then
    echo "Issued certificate does not match the local private key; discarding" >&2
    rm -f "${CERT_FILE}.new" "${CHAIN_FILE}.new"
    exit 1
  fi
  if ! certificate_has_workload "${CERT_FILE}.new"; then
    echo "Issued certificate names another workload; discarding" >&2
    rm -f "${CERT_FILE}.new" "${CHAIN_FILE}.new"
    exit 1
  fi
  mv "${CERT_FILE}.new" "${CERT_FILE}"
  mv "${CHAIN_FILE}.new" "${CHAIN_FILE}"
fi

cat > "${AWS_CONFIG_FILE_PATH}" <<EOF
[profile ${PROFILE_NAME}-entry]
credential_process = /usr/local/bin/aws_signing_helper credential-process --certificate ${CERT_FILE} --private-key ${KEY_FILE} --trust-anchor-arn ${TRUST_ANCHOR_ARN} --profile-arn ${PROFILE_ARN} --role-arn ${ENTRY_ROLE_ARN}

[profile ${PROFILE_NAME}]
source_profile = ${PROFILE_NAME}-entry
role_arn = ${ROLE_ARN}
role_session_name = ${SESSION_NAME}
EOF

export AWS_CONFIG_FILE="${AWS_CONFIG_FILE_PATH}"
export AWS_PROFILE="${PROFILE_NAME}"

# Secrets the workload reads for itself.
#
# Each ${ENV_PREFIX}_SECRET_<NAME> variable holds a parameter path, and its
# value becomes <NAME>. The paths are declared in the compose file beside the
# service that uses them: a path is a public identifier, and keeping it next to
# the consumer is what makes "which secrets does this container hold" a
# question the compose file answers.
#
# Nothing is delivered by the deploy. The workload's own role decides what it
# may read, derived from its project's namespace (ahara-trust ADR-0002).
#
# Failing to fetch fails the container. A service that started anyway would run
# on whatever was in its environment, which is exactly the stale value this
# removes.
secret_prefix="${ENV_PREFIX}_SECRET_"
secret_names="$(env | sed -n "s/^${secret_prefix}\([A-Z0-9_]*\)=.*/\1/p" | sort)"

if [ -n "${secret_names}" ]; then
  if ! command -v aws >/dev/null 2>&1; then
    echo "${ENV_PREFIX}_SECRET_* is set but the AWS CLI is not in this image" >&2
    exit 1
  fi

  # Written by the caller only when it wants files rather than an environment:
  # a vendor image cannot run this wrapper, so an init container writes here
  # and the application reads the files.
  #
  # SECRETS_DIR rather than SECRET_DIR, so this control variable cannot be
  # mistaken for a secret called DIR by the enumeration above.
  WRITE_DIR_VAR="${ENV_PREFIX}_SECRETS_DIR"
  WRITE_DIR="${!WRITE_DIR_VAR:-}"
  if [ -n "${WRITE_DIR}" ]; then
    mkdir -p "${WRITE_DIR}"
    chmod 700 "${WRITE_DIR}"
  fi

  for name in ${secret_names}; do
    path_var="${secret_prefix}${name}"
    path="${!path_var}"
    if [ -z "${path}" ]; then
      echo "${path_var} is empty" >&2
      exit 1
    fi

    # Report what AWS said rather than guessing why. A message asserting the
    # path is wrong sends the reader after the path when the cause was a
    # missing client, an unusable signing helper, or a denied role.
    # HOME is overridden for this call alone. The AWS CLI creates ~/.aws before
    # it reads anything, and a workload whose home is a read-only mount fails
    # there rather than on the parameter. The certificate directory is already
    # ours and already writable; the application keeps the HOME it expects.
    error_file="$(mktemp)"
    if ! value="$(HOME="${CERT_DIR}" aws ssm get-parameter --name "${path}" --with-decryption \
      --query Parameter.Value --output text 2>"${error_file}")"; then
      echo "Cannot read ${path} for ${name}." >&2
      sed 's/^/AWS CLI: /' "${error_file}" >&2
      rm -f "${error_file}"
      exit 1
    fi
    rm -f "${error_file}"
    if [ -z "${value}" ] || [ "${value}" = "None" ]; then
      echo "${path} resolved to nothing" >&2
      exit 1
    fi

    if [ -n "${WRITE_DIR}" ]; then
      # Written through a temporary name so a reader started concurrently
      # never sees a partial secret.
      printf '%s' "${value}" > "${WRITE_DIR}/.${name}.tmp"
      chmod 600 "${WRITE_DIR}/.${name}.tmp"
      mv "${WRITE_DIR}/.${name}.tmp" "${WRITE_DIR}/${name}"
    else
      export "${name}=${value}"
    fi
    unset value
  done

  echo "Fetched $(echo "${secret_names}" | wc -w) secret(s) for ${WORKLOAD_ID}" >&2
fi

if [ $# -gt 0 ]; then
  # The application can outlive a 90-day identity. Refresh daily in the same
  # container; AWS reads the certificate path on each credential request.
  (
    while sleep 86400; do
      if ! "$0" "${ENV_PREFIX}" >/dev/null; then
        echo "Roles Anywhere identity refresh failed; will retry in one day" >&2
      fi
    done
  ) &
  exec "$@"
fi

printf 'export AWS_CONFIG_FILE=%q\n' "${AWS_CONFIG_FILE}"
printf 'export AWS_PROFILE=%q\n' "${AWS_PROFILE}"
