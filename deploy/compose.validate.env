# Non-secret fixture used only by `make validate-deploy`.
#
# No credential appears here, because no credential appears in a deployed
# environment either: every container reads its own from SSM at start with the
# identity the trust appliance issued it (ahara-trust ADR-0002). What remains
# is the image tag, the public Cognito identifiers, and the Roles Anywhere
# discovery values a deploy supplies.
IMAGE_TAG=test
SULION_AUTH_ISSUER_URL=https://issuer.example
SULION_AUTH_CLIENT_ID=test
SULION_COGNITO_USER_POOL_ID=test
SULION_COGNITO_CLIENT_ID=test
SULION_NODE_ID=019d4f28-88ac-7a80-932c-b0f53a0708f4
SULION_NODE_CONTROL_URL=wss://192.168.66.3:30081/ws/nodes

AWS_RA_BACKEND_WORKLOAD_ID=spiffe://ahara/sulion/backend
AWS_RA_BACKEND_ENROLLMENT_URL=https://example.invalid
AWS_RA_BACKEND_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_BACKEND_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_BACKEND_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_BACKEND_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-sulion-backend

AWS_RA_BROKER_WORKLOAD_ID=spiffe://ahara/sulion/broker
AWS_RA_BROKER_ENROLLMENT_URL=https://example.invalid
AWS_RA_BROKER_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_BROKER_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_BROKER_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_BROKER_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-sulion-broker

AWS_RA_RETRIEVAL_WORKLOAD_ID=spiffe://ahara/sulion/retrieval
AWS_RA_RETRIEVAL_ENROLLMENT_URL=https://example.invalid
AWS_RA_RETRIEVAL_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_RETRIEVAL_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_RETRIEVAL_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_RETRIEVAL_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-sulion-retrieval

AWS_RA_CODE_INTEL_WORKLOAD_ID=spiffe://ahara/sulion/code-intel
AWS_RA_CODE_INTEL_ENROLLMENT_URL=https://example.invalid
AWS_RA_CODE_INTEL_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:trust-anchor/local
AWS_RA_CODE_INTEL_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:000000000000:profile/local
AWS_RA_CODE_INTEL_ENTRY_ROLE_ARN=arn:aws:iam::000000000000:role/local-entry
AWS_RA_CODE_INTEL_ROLE_ARN=arn:aws:iam::000000000000:role/ahara-machine-sulion-code-intel
