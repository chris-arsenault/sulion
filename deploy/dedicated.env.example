# Release identity. CI/CD replaces the tag with an immutable release value.
IMAGE_TAG=latest
SULION_IMAGE_REGISTRY=ghcr.io/chris-arsenault/sulion

# Shared TrueNAS Postgres and embedding service.
SULION_POSTGRES_HOST=192.168.66.3
SULION_POSTGRES_PORT=5432
SULION_DB_NAME=sulion
SULION_BROKER_DB_NAME=sulion_broker
SULION_RETRIEVAL_EMBEDDING_URL=http://192.168.66.3:5361

# Dedicated-host filesystem and LAN exposure.
SULION_HOME_HOST_PATH=/home/dev
SULION_REPOS_HOST_PATH=/home/dev/repos
SULION_WORKSPACES_HOST_PATH=/home/dev/workspaces
SULION_BROKER_STATE_HOST_PATH=/var/lib/sulion/broker
SULION_ROOTLESS_DOCKER_SOCKET=/run/user/7321/docker.sock
SULION_NODE_STATE_HOST_PATH=/var/lib/sulion/node
SULION_NODE_ID=019d4f28-88ac-7a80-932c-b0f53a0708f4
SULION_NODE_CONTROL_URL=ws://127.0.0.1:8080/ws/nodes
SULION_FRONTEND_BIND_ADDRESS=0.0.0.0
SULION_FRONTEND_PORT=30080
SULION_DEV_BIND_ADDRESS=0.0.0.0
SULION_DEV_PORT_RANGE=26000-26010
SULION_PUBLIC_URL=https://sulion.services.ahara.io

# Secret-backed values belong in the root-readable runtime env file, not Nix
# source or the repository.
DB_USER=replace-me
DB_PASSWORD=replace-me
BROKER_DB_USER=replace-me
BROKER_DB_PASSWORD=replace-me
SULION_AUTH_ISSUER_URL=replace-me
SULION_AUTH_CLIENT_ID=replace-me
SULION_COGNITO_USER_POOL_ID=replace-me
SULION_COGNITO_CLIENT_ID=replace-me
SULION_SECRET_BROKER_REGISTRATION_TOKEN=replace-me
SULION_RETRIEVAL_TOKEN=replace-me
SULION_CODE_INTEL_TOKEN=replace-me
