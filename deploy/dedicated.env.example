# Field contract for a generic Linux development node.
#
# The NixOS enclave does NOT use this file. There, sulion-node-bootstrap
# generates the non-secret half and sulion-node writes the credential half
# itself after an operator approves it in the UI; see nix/README.md. This
# example remains the reference for a host outside that bootstrap.

# Release identity. CI/CD replaces the tag with an immutable release value.
IMAGE_TAG=latest
SULION_IMAGE_REGISTRY=ghcr.io/chris-arsenault/sulion

# Dedicated node filesystem and outbound control/service endpoints.
SULION_HOME_HOST_PATH=/home/sulion
SULION_REPOS_HOST_PATH=/home/sulion/repos
SULION_WORKSPACES_HOST_PATH=/home/sulion/workspaces
SULION_NODE_STATE_HOST_PATH=/var/lib/sulion/node
SULION_NODE_ID=019d4f28-88ac-7a80-932c-b0f53a0708f4
# The control plane's encrypted LAN node port. /ws/nodes is not served through the
# public reverse proxy, so a node must reach the control plane over the LAN.
SULION_NODE_CONTROL_URL=wss://192.168.66.3:30081/ws/nodes
SULION_NODE_ALLOW_INSECURE_WS=0
# The encrypted LAN node port; node traffic never leaves the network.
SULION_SECRET_BROKER_URL=https://192.168.66.3:30081/broker
SULION_RETRIEVAL_URL=https://192.168.66.3:30081/retrieval
SULION_CODE_INTEL_URL=http://127.0.0.1:8084
SULION_DEV_PORT_RANGE=26000-26010

# Node-only secret-backed values belong in the root-readable runtime env file,
# not Nix source or the repository. Broker database/master-key and Cognito
# credentials remain on TrueNAS and must not be copied here.
#
# The database URL is one value rather than a host, name, user and password:
# nothing on a node assembles a connection string, so there is nothing for the
# parts to be assembled by.
SULION_DB_URL=postgres://replace-me:replace-me@192.168.66.3:5432/sulion
SULION_SECRET_BROKER_REGISTRATION_TOKEN=replace-me
SULION_RETRIEVAL_TOKEN=replace-me
SULION_CODE_INTEL_TOKEN=replace-me
