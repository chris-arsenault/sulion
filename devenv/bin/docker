#!/bin/sh
case "${SULION_DOCKER_MODE:-brokered}" in
  direct)
    exec /usr/bin/docker "$@"
    ;;
  brokered)
    if [ "${1:-}" = "compose" ]; then
      shift
      exec /usr/local/bin/sulion runner-client compose "$@"
    fi
    exec /usr/local/bin/sulion runner-client "$@"
    ;;
  *)
    echo "unsupported SULION_DOCKER_MODE: ${SULION_DOCKER_MODE}" >&2
    exit 64
    ;;
esac
